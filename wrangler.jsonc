{
  "name": "edgraph",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-01",
  "compatibility_flags": ["nodejs_compat"],

  "durable_objects": {
    "bindings": [
      {
        "name": "SKILLS_GRAPH",
        "class_name": "SkillsGraphDO"
      }
    ]
  },

  "r2_buckets": [
    {
      "binding": "SKILLS_BUCKET",
      "bucket_name": "skills-bucket-dev"
    }
  ],

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SkillsGraphDO"]
    }
  ]
}
